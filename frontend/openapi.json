{
  "openapi": "3.1.0",
  "info": {
    "title": "Shipping Ops Agent",
    "description": "Koordinator + 6 agent spesialis dengan review staf",
    "version": "0.4.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "summary": "Agents",
        "operationId": "agents_api_agents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentInfo"
                  },
                  "type": "array",
                  "title": "Response Agents Api Agents Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "List Runs",
        "operationId": "list_runs_api_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunListItem"
                  },
                  "type": "array",
                  "title": "Response List Runs Api Runs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start Upload",
        "operationId": "start_upload_api_runs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_start_upload_api_runs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/demo": {
      "post": {
        "summary": "Start Demo",
        "operationId": "start_demo_api_runs_demo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ask": {
      "post": {
        "summary": "Ask",
        "description": "Coordinator only, no files: shows which agent would handle the request.",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_ask_api_ask_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/decisions": {
      "post": {
        "summary": "Submit Decisions",
        "operationId": "submit_decisions_api_runs__run_id__decisions_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionsIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/files/{name}": {
      "get": {
        "summary": "Download",
        "operationId": "download_api_runs__run_id__files__name__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "demo_request": {
            "type": "string",
            "title": "Demo Request"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/DecisionOption"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "description",
          "demo_request",
          "options"
        ],
        "title": "AgentInfo"
      },
      "Body_ask_api_ask_post": {
        "properties": {
          "request": {
            "type": "string",
            "title": "Request"
          }
        },
        "type": "object",
        "required": [
          "request"
        ],
        "title": "Body_ask_api_ask_post"
      },
      "Body_start_upload_api_runs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "Input files (.xlsx/.xls/.csv/.txt/.eml)"
          },
          "request": {
            "type": "string",
            "title": "Request",
            "description": "What should be done; the coordinator picks the agent",
            "default": ""
          },
          "agent": {
            "type": "string",
            "title": "Agent",
            "description": "Optional: skip the coordinator and use this agent",
            "default": ""
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "Upload"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_start_upload_api_runs_post"
      },
      "DecisionIn": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "decision": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "decision"
        ],
        "title": "DecisionIn"
      },
      "DecisionOption": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "tone": {
            "type": "string",
            "title": "Tone",
            "description": "approve | reject | ask: colour hint for the dashboard"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "tone"
        ],
        "title": "DecisionOption"
      },
      "DecisionsIn": {
        "properties": {
          "reviewer": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Reviewer"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionIn"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "reviewer",
          "decisions"
        ],
        "title": "DecisionsIn"
      },
      "DemoIn": {
        "properties": {
          "agent": {
            "type": "string",
            "title": "Agent",
            "default": "reconciliation"
          }
        },
        "type": "object",
        "title": "DemoIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Kpi": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "title": "Kpi"
      },
      "ReviewDecision": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "reviewer": {
            "type": "string",
            "title": "Reviewer"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "decision",
          "reviewer"
        ],
        "title": "ReviewDecision"
      },
      "ReviewItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "subject": {
            "type": "string",
            "title": "Subject",
            "description": "What the item is about: container, invoice no, email, quotation..."
          },
          "group": {
            "type": "string",
            "title": "Group",
            "description": "Human label used to group items in the dashboard chart"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "Machine name of the rule or item type"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected"
          },
          "actual": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "suggestion": {
            "type": "string",
            "title": "Suggestion"
          },
          "draft": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft",
            "description": "Draft text (email, quotation) shown to the reviewer"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Agent payload used by finalize"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "group",
          "kind",
          "severity",
          "title",
          "suggestion"
        ],
        "title": "ReviewItem"
      },
      "RunListItem": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_review",
              "done",
              "answered",
              "error"
            ],
            "title": "Status"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent"
          },
          "agent_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Label"
          },
          "items": {
            "type": "integer",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "label",
          "created_at",
          "status",
          "agent",
          "agent_label",
          "items"
        ],
        "title": "RunListItem"
      },
      "RunView": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "request": {
            "type": "string",
            "title": "Request"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_review",
              "done",
              "answered",
              "error"
            ],
            "title": "Status"
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "route_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route Reason"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent"
          },
          "agent_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Label"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "subject_label": {
            "type": "string",
            "title": "Subject Label"
          },
          "kpis": {
            "items": {
              "$ref": "#/components/schemas/Kpi"
            },
            "type": "array",
            "title": "Kpis"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewItem"
            },
            "type": "array",
            "title": "Items"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          },
          "narrative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Narrative"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/DecisionOption"
            },
            "type": "array",
            "title": "Options"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/ReviewDecision"
            },
            "type": "array",
            "title": "Decisions"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files"
          },
          "log": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Log"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "label",
          "request",
          "created_at",
          "status",
          "route",
          "route_reason",
          "answer",
          "agent",
          "agent_label",
          "title",
          "subject_label",
          "kpis",
          "items",
          "notes",
          "narrative",
          "options",
          "decisions",
          "files",
          "log"
        ],
        "title": "RunView"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "title": "Severity"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}