# Optional. Without these the agent runs fully offline with rule-based routing
# and a template briefing. Requires: pip install -e ".[llm]"
ANTHROPIC_API_KEY=
# Any Anthropic chat model id your key can use
LLM_MODEL=

# Optional. Without these, Agent Email only writes draft .eml files to disk;
# the "Kirim Email" button stays disabled. For Gmail, SMTP_USER/PASSWORD is a
# Google Account App Password, not your normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional. Without these, there's no "Ambil Email Baru (IMAP)" button; staff
# keep exporting .eml manually and uploading them. Connects read-only: it can
# only look at the mailbox, never change flags or delete anything.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
IMAP_FETCH_DAYS=7
